NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://leopard:leopard_local@localhost:5432/leopard?schema=public
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

POSTGRES_DB=leopard
POSTGRES_USER=leopard
POSTGRES_PASSWORD=leopard_local
POSTGRES_PORT=5432

AUTH_PROVIDER=demo
AUTH_DEMO_LOGIN_ENABLED=true
AUTH_ACCESS_TOKEN_SECRET=change-me-local-access-token-secret-32-bytes
AUTH_REFRESH_TOKEN_SECRET=change-me-local-refresh-token-secret-32-bytes
MAP_PROVIDER=demo
ALLOW_DEMO_PROVIDER=true
STORAGE_PROVIDER=local
PAYMENT_PROVIDER=demo

VIETMAP_API_KEY=
FIREBASE_PROJECT_ID=leopard-local
GOOGLE_APPLICATION_CREDENTIALS=
ESTIMATE_TOKEN_HMAC_SECRET=change-me-local-estimate-token-secret-32-bytes
PRICING_MINIMUM_FARE_VND=10000
PRICING_STOP_SURCHARGE_VND=2500
PRICING_VEHICLE_RATES_JSON={"MOTORBIKE":{"baseFareVnd":10000,"perKmVnd":3500},"VAN":{"baseFareVnd":20000,"perKmVnd":8000},"TRUCK":{"baseFareVnd":35000,"perKmVnd":12000}}
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

API_PORT=3000
ADMIN_PORT=3002

ENABLE_API_DOCS=false
