NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://leopard:leopard_local@localhost:5432/leopard?schema=public
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

POSTGRES_DB=leopard
POSTGRES_USER=leopard
POSTGRES_PASSWORD=leopard_local
POSTGRES_PORT=5432

AUTH_PROVIDER=demo
AUTH_DEMO_LOGIN_ENABLED=true
AUTH_ACCESS_TOKEN_SECRET=change-me-local-access-token-secret-32-bytes
AUTH_REFRESH_TOKEN_SECRET=change-me-local-refresh-token-secret-32-bytes
MAP_PROVIDER=demo
ALLOW_DEMO_PROVIDER=true
SOCKET_PROVIDER=in-memory
ALLOW_IN_MEMORY_SOCKET_PROVIDER=true
STORAGE_PROVIDER=local
ALLOW_LOCAL_STORAGE_PROVIDER=true
PAYMENT_PROVIDER=demo
ALLOW_DEMO_PAYMENT_PROVIDER=true

VIETMAP_API_KEY=
FIREBASE_PROJECT_ID=leopard-local
GOOGLE_APPLICATION_CREDENTIALS=
# Set true to send push notifications via Firebase Cloud Messaging; requires FIREBASE_PROJECT_ID.
FCM_ENABLED=false
# Public VAPID key for the customer web/PWA client to request a push subscription; leave blank to disable push registration on that client.
EXPO_PUBLIC_FIREBASE_VAPID_KEY=
ESTIMATE_TOKEN_HMAC_SECRET=change-me-local-estimate-token-secret-32-bytes
PRICING_MINIMUM_FARE_VND=10000
PRICING_STOP_SURCHARGE_VND=2500
PRICING_VEHICLE_RATES_JSON={"MOTORBIKE":{"baseFareVnd":10000,"perKmVnd":3500},"VAN":{"baseFareVnd":20000,"perKmVnd":8000},"TRUCK":{"baseFareVnd":35000,"perKmVnd":12000}}
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Self-generated VAT-style invoice (default) vs a future authority-issued e-invoice provider (not implemented yet).
INVOICE_PROVIDER=self
# console (default, logs the link — no real delivery) or smtp (sends via nodemailer).
MAIL_PROVIDER=console
ALLOW_CONSOLE_MAIL_PROVIDER=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=ap-southeast-1
# Optional for S3-compatible storage; leave blank for AWS S3.
S3_ENDPOINT=

API_PORT=3000
ADMIN_PORT=3002

ENABLE_API_DOCS=false
