{
  "expo": {
    "name": "LEOPARD Pilot",
    "slug": "leopard-pilot",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "leopard",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.leopard.pilot",
      "supportsTablet": false
    },
    "android": {
      "package": "com.leopard.pilot"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "LEOPARD cần quyền truy cập thư viện ảnh để chọn ảnh hàng hóa hoặc ảnh xác nhận giao hàng."
        }
      ]
    ]
  }
}
