{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "jest --config jest.config.cjs --passWithNoTests",
    "test:e2e": "jest --config jest-e2e.config.cjs --runInBand",
    "test:contract": "jest --config jest.config.cjs --passWithNoTests --testPathPatterns=openapi-contract",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:test": "prisma generate --schema prisma/schema.prisma && prisma migrate deploy --schema prisma/schema.prisma && jest --config jest-database.config.cjs --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1085.0",
    "@aws-sdk/s3-request-presigner": "3.1085.0",
    "@leopard/shared": "workspace:*",
    "@leopard/validators": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/websockets": "11.1.28",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "file-type": "21.3.4",
    "firebase-admin": "14.2.0",
    "js-yaml": "4.3.0",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "swagger-ui-express": "5.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@leopard/config": "workspace:*",
    "@nestjs/cli": "11.0.14",
    "@nestjs/testing": "11.1.28",
    "@swc/core": "1.15.46",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.10.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "jest": "30.0.5",
    "prisma": "7.8.0",
    "socket.io-client": "4.8.3",
    "supertest": "7.2.2"
  }
}
