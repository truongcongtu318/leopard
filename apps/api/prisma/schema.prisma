generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  DRIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING_APPROVAL
  REJECTED
  SUSPENDED
}

enum DriverAvailability {
  OFFLINE
  AVAILABLE
  BUSY
}

enum VehicleType {
  MOTORBIKE
  VAN
  TRUCK
}

enum OrderStatus {
  REQUESTED
  ACCEPTED
  PICKING_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  INCIDENT_CANCELLED
  RETURNING
  RETURNED
}

enum StopType {
  PICKUP
  STOP
  DROPOFF
}

enum MediaType {
  CARGO
  PICKUP_PROOF
  DELIVERY_PROOF
}

enum PaymentStatus {
  UNPAID
  QR_CREATED
  PAID_MANUAL
  FAILED
}

enum ProviderSource {
  VIETMAP
  DEMO
  PAYOS
  VIETQR
  LOCAL
  S3
}

enum NotificationType {
  ORDER
  PAYMENT
  PROMO
  SYSTEM
}

enum InvoiceStatus {
  ISSUED
  VOIDED
}

enum PromotionDiscountType {
  PERCENT
  FIXED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum RouteSnapshotReason {
  INITIAL_QUOTE
  REROUTE
  STOP_COMPLETED
  MANUAL_RECOVERY
}

enum RouteProviderSource {
  VIETMAP
  DEMO
}

enum VehicleProfileSource {
  STANDARD_QUOTE_PROFILE
  ASSIGNED_VEHICLE_PROFILE
  MANUAL_RECOVERY
}

enum RouteSnapshotQuality {
  VERIFIED_PROVIDER
  DEMO
  LEGACY_RECOVERED
  PARTIAL
}

enum EstimateKind {
  NEXT_STOP
  COMPLETION
}

enum LiveEstimateStatus {
  AVAILABLE
  UNAVAILABLE
  SUPERSEDED
}

enum EtaUnavailableReason {
  NO_TARGET_STOP
  GPS_TOO_OLD
  ROUTE_UNAVAILABLE
  PROVIDER_EXHAUSTED
  INVALID_ROUTE_INPUT
}

enum EtaAdjustmentSource {
  NONE
  WEATHER
  OPERATIONAL
  WEATHER_AND_OPERATIONAL
}

enum OutboxEventType {
  ROUTE_ETA_RECOMPUTE
  ROUTE_ETA_UPDATED
  ROUTE_UPDATED
}

enum OutboxEventStatus {
  PENDING
  LEASED
  COMPLETED
  DEAD_LETTER
}

enum StopProgressStep {
  ARRIVED
  SERVICE_STARTED
  SERVICE_COMPLETED
}

enum StopProgressAction {
  RECORDED
  VOIDED
}

model User {
  id                             String                  @id @default(uuid()) @db.Uuid
  firebaseUid                    String?                 @unique @db.VarChar(128)
  phone                          String?                 @unique @db.VarChar(32)
  email                          String?                 @unique @db.VarChar(255)
  name                           String?                 @db.VarChar(120)
  phoneVerifiedAt                DateTime?               @db.Timestamptz(3)
  emailVerifiedAt                DateTime?               @db.Timestamptz(3)
  onboardedAt                    DateTime?               @db.Timestamptz(3)
  consentTermsAt                 DateTime?               @db.Timestamptz(3)
  consentServiceAt               DateTime?               @db.Timestamptz(3)
  consentMarketing               Boolean                 @default(false)
  consentThirdParty              Boolean                 @default(false)
  avatarMediaId                  String?                 @db.Uuid
  avatarStorageKey               String?                 @db.VarChar(500)
  avatarContentType              String?                 @db.VarChar(100)
  role                           Role
  status                         UserStatus              @default(ACTIVE)
  createdAt                      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime                @default(now()) @updatedAt @db.Timestamptz(3)
  refreshSessions                RefreshSession[]
  driverProfile                  DriverProfile?
  customerOrders                 Order[]                 @relation("CustomerOrders")
  driverOrders                   Order[]                 @relation("DriverOrders")
  statusChanges                  OrderStatusHistory[]    @relation("OrderStatusActor")
  dispatchOffersReceived         OrderDispatchOffer[]    @relation("OrderDispatchOfferDriver")
  trackingPoints                 TrackingPoint[]         @relation("TrackingDriver")
  mediaObjects                   MediaObject[]           @relation("MediaUploader")
  confirmedPayments              PaymentIntent[]         @relation("PaymentConfirmer")
  withdrawalRequests             WithdrawalRequest[]     @relation("DriverWithdrawals")
  reviewedWithdrawals            WithdrawalRequest[]     @relation("WithdrawalReviewer")
  auditLogs                      AuditLog[]              @relation("AuditActor")
  notifications                  Notification[]
  deviceTokens                   DeviceToken[]
  customerAddresses              CustomerAddress[]
  orderMessages                  OrderMessage[]
  orderReviews                   OrderReview[]           @relation("ReviewCustomer")
  supportTickets                 SupportTicket[]         @relation("TicketCustomer")
  driverApplications             DriverApplication[]
  verifiedVehicleRoutingProfiles VehicleRoutingProfile[] @relation("VehicleProfileVerifier")
  stopProgressActions            StopProgressEvent[]     @relation("StopProgressActor")
  driverDeposits                 DriverDeposit[]         @relation("DriverDeposits")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt(sort: Desc)])
}

model DriverProfile {
  id                    String                                @id @default(uuid()) @db.Uuid
  userId                String                                @unique @db.Uuid
  availability          DriverAvailability                    @default(OFFLINE)
  vehicleType           VehicleType
  licensePlate          String?                               @db.VarChar(32)
  licenseNumber         String?                               @db.VarChar(64)
  fleetCode             String?                               @db.VarChar(64)
  operatingCity         String?                               @db.VarChar(120)
  submittedAt           DateTime?                             @db.Timestamptz(3)
  reviewedAt            DateTime?                             @db.Timestamptz(3)
  reviewedById          String?                               @db.Uuid
  rejectionReason       String?
  contractVersion       String?                               @db.VarChar(32)
  contractSignedAt      DateTime?                             @db.Timestamptz(3)
  lastKnownLocation     Unsupported("geography(Point,4326)")?
  lastKnownAt           DateTime?                             @db.Timestamptz(3)
  balanceVnd            Int                                   @default(0)
  bankName              String?                               @db.VarChar(100)
  bankAccountNumber     String?                               @db.VarChar(50)
  bankAccountName       String?                               @db.VarChar(120)
  autoOfflineOnComplete Boolean                               @default(false)
  createdAt             DateTime                              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                              @default(now()) @updatedAt @db.Timestamptz(3)
  user                  User                                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  documents             DriverDocument[]
  contracts             DriverContract[]
  payoutRequests        PayoutRequest[]
  routingProfiles       VehicleRoutingProfile[]

  @@index([availability, vehicleType, lastKnownAt])
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
}

model PayoutRequest {
  id                String        @id @default(uuid()) @db.Uuid
  driverProfileId   String        @db.Uuid
  amountVnd         Int
  status            PayoutStatus  @default(PENDING)
  bankName          String        @db.VarChar(100)
  bankAccountNumber String        @db.VarChar(50)
  bankAccountName   String        @db.VarChar(120)
  processedAt       DateTime?     @db.Timestamptz(3)
  processedById     String?       @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  driverProfile     DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@index([driverProfileId, status])
}

enum DriverDocumentType {
  LICENSE
  VEHICLE_REGISTRATION
  ID_CARD
  VEHICLE_PHOTO
  INSPECTION_CERTIFICATE
  MANDATORY_INSURANCE
}

enum DocumentReviewStatus {
  PENDING_REVIEW
  VERIFIED
  ACTION_REQUIRED
  REJECTED
  EXPIRED
}

model DriverDocument {
  id              String               @id @default(uuid()) @db.Uuid
  driverProfileId String               @db.Uuid
  type            DriverDocumentType
  provider        ProviderSource
  storageKey      String               @unique
  contentType     String
  sizeBytes       Int
  checksumSha256  String
  documentNumber  String?              @db.VarChar(64)
  holderName      String?              @db.VarChar(120)
  issuedAt        DateTime?            @db.Timestamptz(3)
  expiresAt       DateTime?            @db.Timestamptz(3)
  reviewStatus    DocumentReviewStatus @default(PENDING_REVIEW)
  reasonCode      String?              @db.VarChar(64)
  reviewedById    String?              @db.Uuid
  reviewedAt      DateTime?            @db.Timestamptz(3)
  clientRequestId String?
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  driverProfile   DriverProfile        @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@index([driverProfileId, type])
}

model DriverContract {
  id                  String        @id @default(uuid()) @db.Uuid
  driverProfileId     String        @db.Uuid
  version             String        @db.VarChar(32)
  pdfStorageKey       String        @unique
  signatureStorageKey String?       @unique
  signedByName        String        @db.VarChar(120)
  signedAt            DateTime      @db.Timestamptz(3)
  ipAddress           String?       @db.VarChar(64)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  driverProfile       DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@unique([driverProfileId, version])
  @@index([driverProfileId])
}

model Order {
  id                  String               @id @default(uuid()) @db.Uuid
  customerId          String               @db.Uuid
  clientRequestId     String?
  driverId            String?              @db.Uuid
  vehicleType         VehicleType          @default(MOTORBIKE)
  cargoWeightKg       Int?
  cargoNote           String?
  status              OrderStatus          @default(REQUESTED)
  routeSnapshot       Json?
  providerSource      ProviderSource?
  distanceMeters      Int?
  durationSeconds     Int?
  priceVnd            Int?
  etaSeconds          Int?
  proofMediaId        String?              @db.Uuid
  pickupProofMediaId  String?              @db.Uuid
  incidentReason      String?
  incidentNote        String?
  incidentReportedAt  DateTime?            @db.Timestamptz(3)
  acceptedAt          DateTime?            @db.Timestamptz(3)
  pickingUpAt         DateTime?            @db.Timestamptz(3)
  inTransitAt         DateTime?            @db.Timestamptz(3)
  deliveredAt         DateTime?            @db.Timestamptz(3)
  cancelledAt         DateTime?            @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @updatedAt @db.Timestamptz(3)

  routeEtaInputRevision  Int       @default(0)
  routeSnapshotVersion   Int       @default(0)
  routeEtaLastBumpAt     DateTime? @db.Timestamptz(3)
  routeEtaLastGpsPointId String?   @db.Uuid

  quotedRouteSnapshotId       String? @db.Uuid
  activeRouteSnapshotId       String? @db.Uuid
  currentNextStopEstimateId   String? @db.Uuid
  currentCompletionEstimateId String? @db.Uuid

  customer            User                 @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  driver              User?                @relation("DriverOrders", fields: [driverId], references: [id], onDelete: Restrict)
  stops               OrderStop[]
  statusHistory       OrderStatusHistory[]
  trackingPoints      TrackingPoint[]
  mediaObjects        MediaObject[]
  paymentIntents      PaymentIntent[]
  invoice             Invoice?
  messages            OrderMessage[]
  reviews             OrderReview[]
  supportTickets      SupportTicket[]

  quotedRouteSnapshot OrderRouteSnapshot?  @relation("QuotedRoute", fields: [id, quotedRouteSnapshotId], references: [orderId, id])
  activeRouteSnapshot OrderRouteSnapshot?  @relation("ActiveRoute", fields: [id, activeRouteSnapshotId], references: [orderId, id])
  routeSnapshots      OrderRouteSnapshot[] @relation("OrderRouteHistory")

  currentNextStopEstimate   OrderLiveEstimate?  @relation("CurrentNextStopEstimate", fields: [id, currentNextStopEstimateId], references: [orderId, id])
  currentCompletionEstimate OrderLiveEstimate?  @relation("CurrentCompletionEstimate", fields: [id, currentCompletionEstimateId], references: [orderId, id])
  liveEstimates             OrderLiveEstimate[] @relation("OrderLiveEstimateHistory")

  stopProgressEvents StopProgressEvent[]
  stopProgressStates StopProgressState[]

  dispatchOffers OrderDispatchOffer[]

  @@unique([customerId, clientRequestId])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([status, vehicleType, createdAt(sort: Desc)])
}

enum OrderDispatchOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model OrderDispatchOffer {
  id          String                    @id @default(uuid()) @db.Uuid
  orderId     String                    @db.Uuid
  driverId    String                    @db.Uuid
  status      OrderDispatchOfferStatus  @default(PENDING)
  offeredAt   DateTime                  @default(now()) @db.Timestamptz(3)
  respondedAt DateTime?                 @db.Timestamptz(3)
  order       Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  driver      User                      @relation("OrderDispatchOfferDriver", fields: [driverId], references: [id], onDelete: Restrict)

  @@unique([orderId, driverId])
  @@index([orderId, status])
}

model OrderStop {
  id                  String                               @id @default(uuid()) @db.Uuid
  orderId             String                               @db.Uuid
  type                StopType
  sequence            Int
  address             String
  contactName         String?                              @db.VarChar(120)
  contactPhone        String?                              @db.VarChar(32)
  note                String?
  location            Unsupported("geography(Point,4326)")
  createdAt           DateTime                             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                             @default(now()) @updatedAt @db.Timestamptz(3)
  order               Order                                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  stopProgressEvents  StopProgressEvent[]
  stopProgressStates  StopProgressState[]
  liveEstimateTargets OrderLiveEstimate[]

  @@unique([orderId, sequence])
  @@unique([id, orderId])
}

model OrderStatusHistory {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @db.Uuid
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  actorId         String?      @db.Uuid
  clientRequestId String?
  reason          String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor           User?        @relation("OrderStatusActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([orderId, actorId, clientRequestId])
  @@index([orderId, createdAt(sort: Desc)])
}

model TrackingPoint {
  id            String                               @id @default(uuid()) @db.Uuid
  orderId       String                               @db.Uuid
  driverId      String                               @db.Uuid
  clientPointId String
  location      Unsupported("geography(Point,4326)")
  accuracyM     Float?
  capturedAt    DateTime                             @db.Timestamptz(3)
  createdAt     DateTime                             @default(now()) @db.Timestamptz(3)
  order         Order                                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  driver        User                                 @relation("TrackingDriver", fields: [driverId], references: [id], onDelete: Restrict)
  liveEstimates OrderLiveEstimate[]

  @@unique([orderId, clientPointId])
  @@index([orderId, capturedAt(sort: Desc)])
}

model MediaObject {
  id              String         @id @default(uuid()) @db.Uuid
  orderId         String         @db.Uuid
  uploaderId      String         @db.Uuid
  type            MediaType
  provider        ProviderSource
  storageKey      String         @unique
  contentType     String
  sizeBytes       Int
  checksumSha256  String
  clientRequestId String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  uploader        User           @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
}

model PaymentIntent {
  id                    String          @id @default(uuid()) @db.Uuid
  orderId               String          @db.Uuid
  provider              ProviderSource?
  status                PaymentStatus   @default(UNPAID)
  amountVnd             Int
  clientRequestId       String?
  providerReference     String?
  payosOrderCode        BigInt?
  qrPayload             String?
  providerSnapshot      Json?
  expiresAt             DateTime?       @db.Timestamptz(3)
  confirmedById         String?         @db.Uuid
  confirmedAt           DateTime?       @db.Timestamptz(3)
  confirmationNote      String?
  confirmationRequestId String?
  createdAt             DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  confirmedBy           User?           @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  invoice               Invoice?

  @@unique([payosOrderCode])
  @@index([orderId, createdAt(sort: Desc)])
}

model InvoiceSequence {
  year      Int      @id
  lastValue Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @unique @db.Uuid
  paymentIntentId String        @unique @db.Uuid
  invoiceNumber   String        @unique
  customerName    String        @db.VarChar(120)
  customerEmail   String?       @db.VarChar(255)
  customerTaxCode String?       @db.VarChar(20)
  customerAddress String?       @db.VarChar(255)
  amountVnd       Int
  vatRateVnd      Int
  totalVnd        Int
  pdfStorageKey   String        @unique
  status          InvoiceStatus @default(ISSUED)
  emailSentAt     DateTime?     @db.Timestamptz(3)
  issuedAt        DateTime      @default(now()) @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model AuditLog {
  id                   String   @id @default(uuid()) @db.Uuid
  actorId              String?  @db.Uuid
  action               String
  resourceType         String
  resourceId           String?  @db.Uuid
  requestId            String?
  idempotencyRequestId String?
  metadata             Json?
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  actor                User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId, createdAt(sort: Desc)])
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model WithdrawalRequest {
  id                String           @id @default(uuid()) @db.Uuid
  driverId          String           @db.Uuid
  amountVnd         Int
  status            WithdrawalStatus @default(PENDING)
  bankName          String?          @db.VarChar(120)
  bankAccountNumber String?          @db.VarChar(32)
  bankAccountName   String?          @db.VarChar(120)
  clientRequestId   String?
  reviewedById      String?          @db.Uuid
  reviewedAt        DateTime?        @db.Timestamptz(3)
  reviewNote        String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  driver            User             @relation("DriverWithdrawals", fields: [driverId], references: [id], onDelete: Restrict)
  reviewedBy        User?            @relation("WithdrawalReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([driverId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

enum DepositStatus {
  PENDING
  COMPLETED
  CANCELLED
  EXPIRED
}

model DriverDeposit {
  id              String        @id @default(uuid()) @db.Uuid
  driverId        String        @db.Uuid
  amountVnd       Int
  status          DepositStatus @default(PENDING)
  payosOrderCode  BigInt        @unique
  qrPayload       String?
  clientRequestId String?
  completedAt     DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  driver          User          @relation("DriverDeposits", fields: [driverId], references: [id], onDelete: Restrict)

  @@index([driverId, createdAt(sort: Desc)])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique
  platform   String   @db.VarChar(16)
  lastUsedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastUsedAt(sort: Desc)])
}

model CustomerAddress {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  label     String   @db.VarChar(64)
  address   String   @db.VarChar(500)
  latitude  Float
  longitude Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model OrderMessage {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  senderId  String   @db.Uuid
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt(sort: Asc)])
}

model OrderReview {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  customerId String   @db.Uuid
  rating     Int
  comment    String?  @db.VarChar(2000)
  tipVnd     Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer   User     @relation("ReviewCustomer", fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([orderId, customerId])
  @@index([orderId])
}

model SupportTicket {
  id          String              @id @default(uuid()) @db.Uuid
  orderId     String?             @db.Uuid
  customerId  String              @db.Uuid
  category    String              @db.VarChar(64)
  description String              @db.VarChar(4000)
  hasPhoto    Boolean             @default(false)
  status      SupportTicketStatus @default(OPEN)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer    User                @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt(sort: Desc)])
  @@index([orderId])
}

model PromotionVoucher {
  id                 String                 @id @default(uuid()) @db.Uuid
  code               String                 @unique @db.VarChar(32)
  title              String                 @db.VarChar(200)
  description        String?                @db.VarChar(1000)
  discountType       PromotionDiscountType
  discountValue      Int
  maxDiscountVnd     Int?
  minOrderAmountVnd  Int                    @default(0)
  usageLimit         Int?
  usageCount         Int                    @default(0)
  expiresAt          DateTime?              @db.Timestamptz(3)
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([isActive, expiresAt])
}

enum DriverApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum DriverLegalModel {
  FLEET_AFFILIATED
  EMPLOYEE
  INDEPENDENT_OPERATOR
}

model DriverApplication {
  id                 String                  @id @default(uuid()) @db.Uuid
  userId             String                  @db.Uuid
  legalModel         DriverLegalModel        @default(FLEET_AFFILIATED)
  status             DriverApplicationStatus @default(SUBMITTED)
  operatingCity      String?                 @db.VarChar(120)
  fleetCode          String?                 @db.VarChar(64)
  vehicleType        VehicleType             @default(VAN)
  licensePlate       String?                 @db.VarChar(32)
  licenseNumber      String?                 @db.VarChar(64)
  currentRevision    Int                     @default(1)
  rejectionReason    String?
  decisionReasonCode String?                 @db.VarChar(64)
  submittedAt        DateTime?               @db.Timestamptz(3)
  reviewedAt         DateTime?               @db.Timestamptz(3)
  reviewedById       String?                 @db.Uuid
  approvedAt         DateTime?               @db.Timestamptz(3)
  rejectedAt         DateTime?               @db.Timestamptz(3)
  withdrawnAt        DateTime?               @db.Timestamptz(3)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @default(now()) @updatedAt @db.Timestamptz(3)
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, submittedAt(sort: Desc)])
}


model ContractAcceptance {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  driverProfileId String?   @db.Uuid
  contractVersion String    @db.VarChar(32)
  documentHash    String    @db.VarChar(128)
  pdfStorageKey   String    @db.VarChar(500)
  signMethod      String    @default("OTP")
  authEventId     String?   @db.VarChar(128)
  signedPhone     String?   @db.VarChar(32)
  signedByName    String    @db.VarChar(120)
  signedAt        DateTime  @default(now()) @db.Timestamptz(3)
  evidenceMetadata Json?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, contractVersion])
}

model ConsentRecord {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  noticeType    String    @db.VarChar(64)
  noticeVersion String    @db.VarChar(32)
  purpose       String    @db.VarChar(128)
  decision      Boolean   @default(true)
  capturedAt    DateTime  @default(now()) @db.Timestamptz(3)
  withdrawnAt   DateTime? @db.Timestamptz(3)
  evidence      Json?

  @@index([userId, noticeType])
}

model VehicleRoutingProfile {
  id               String      @id @default(uuid()) @db.Uuid
  driverProfileId  String      @db.Uuid
  version          Int
  vehicleType      VehicleType
  tareWeightKg     Int
  maxPayloadKg     Int
  maxGrossWeightKg Int
  verifiedAt       DateTime?   @db.Timestamptz(3)
  verifiedById     String?     @db.Uuid
  supersededAt     DateTime?   @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)

  driverProfile  DriverProfile        @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)
  verifiedBy     User?                @relation("VehicleProfileVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  routeSnapshots OrderRouteSnapshot[]

  @@unique([driverProfileId, version])
  @@index([driverProfileId, supersededAt])
}

model QuoteVehicleRoutingPolicy {
  id                      String               @id @default(uuid()) @db.Uuid
  vehicleType             VehicleType
  version                 Int
  assumedTareWeightKg     Int
  assumedMaxPayloadKg     Int
  assumedMaxGrossWeightKg Int
  operationalAllowanceKg  Int                  @default(0)
  effectiveFrom           DateTime             @db.Timestamptz(3)
  supersededAt            DateTime?            @db.Timestamptz(3)
  createdAt               DateTime             @default(now()) @db.Timestamptz(3)
  routeSnapshots          OrderRouteSnapshot[]

  @@unique([vehicleType, version])
  @@index([vehicleType, supersededAt])
}

model OrderRouteSnapshot {
  id                          String               @id @default(uuid()) @db.Uuid
  orderId                     String               @db.Uuid
  version                     Int
  reason                      RouteSnapshotReason
  quality                     RouteSnapshotQuality
  geometry                    String
  geometryEncoding            String               @db.VarChar(16)
  routeHash                   String               @db.VarChar(64)
  inputHash                   String               @db.VarChar(64)
  hashAlgorithmVersion        String               @db.VarChar(16)
  providerRouteId             String?
  legs                        Json
  stopSequence                Json
  normalizedInput             Json
  vehicleProfileSource        VehicleProfileSource
  vehicleRoutingProfileId     String?              @db.Uuid
  quoteVehicleRoutingPolicyId String?              @db.Uuid
  departureAt                 DateTime             @db.Timestamptz(3)
  source                      RouteProviderSource
  calculatedAt                DateTime             @db.Timestamptz(3)
  legacySourceSnapshotJson    Json?
  legacyMissingFields         String[]
  recoveryJobVersion          String?
  recoveredAt                 DateTime?            @db.Timestamptz(3)
  createdAt                   DateTime             @default(now()) @db.Timestamptz(3)

  order                     Order                      @relation("OrderRouteHistory", fields: [orderId], references: [id], onDelete: Restrict)
  vehicleRoutingProfile     VehicleRoutingProfile?     @relation(fields: [vehicleRoutingProfileId], references: [id], onDelete: Restrict)
  quoteVehicleRoutingPolicy QuoteVehicleRoutingPolicy? @relation(fields: [quoteVehicleRoutingPolicyId], references: [id], onDelete: Restrict)
  quotedForOrders           Order[]                    @relation("QuotedRoute")
  activeForOrders           Order[]                    @relation("ActiveRoute")
  liveEstimates             OrderLiveEstimate[]

  @@unique([orderId, version])
  @@unique([orderId, id], map: "order_route_snapshot_order_id_id_key")
}

model OrderLiveEstimate {
  id                     String                @id @default(uuid()) @db.Uuid
  orderId                String                @db.Uuid
  inputRevision          Int
  kind                   EstimateKind
  targetStopId           String?               @db.Uuid
  routeSnapshotId        String                @db.Uuid
  status                 LiveEstimateStatus
  unavailableReason      EtaUnavailableReason?
  remainingDistanceM     Int?
  remainingDurationS     Int?
  arrivalAt              DateTime?             @db.Timestamptz(3)
  baselineDurationS      Int?
  adjustmentDurationS    Int                   @default(0)
  baselineSource         RouteProviderSource
  adjustmentSource       EtaAdjustmentSource   @default(NONE)
  weatherSnapshotVersion Int?
  policyVersion          Int                   @default(1)
  gpsPointId             String?               @db.Uuid
  calculatedAt           DateTime              @db.Timestamptz(3)
  validUntil             DateTime              @db.Timestamptz(3)
  createdAt              DateTime              @default(now()) @db.Timestamptz(3)

  order                Order              @relation("OrderLiveEstimateHistory", fields: [orderId], references: [id], onDelete: Restrict)
  routeSnapshot        OrderRouteSnapshot @relation(fields: [orderId, routeSnapshotId], references: [orderId, id])
  targetStop           OrderStop?         @relation(fields: [targetStopId], references: [id], onDelete: Restrict)
  gpsPoint             TrackingPoint?     @relation(fields: [gpsPointId], references: [id], onDelete: SetNull)
  currentForNextStop   Order[]            @relation("CurrentNextStopEstimate")
  currentForCompletion Order[]            @relation("CurrentCompletionEstimate")

  @@unique([orderId, inputRevision, kind])
  @@unique([orderId, id], map: "order_live_estimate_order_id_id_key")
  @@index([orderId, inputRevision])
  @@index([orderId, status, kind])
}

model StopProgressEvent {
  id                String             @id @default(uuid()) @db.Uuid
  orderId           String             @db.Uuid
  stopId            String             @db.Uuid
  step              StopProgressStep
  action            StopProgressAction @default(RECORDED)
  actorId           String             @db.Uuid
  clientRequestId   String?
  occurredAt        DateTime           @db.Timestamptz(3)
  supersedesEventId String?            @unique @db.Uuid
  reason            String?            @db.VarChar(500)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)

  order        Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  stop         OrderStop          @relation(fields: [stopId, orderId], references: [id, orderId], onDelete: Restrict)
  actor        User               @relation("StopProgressActor", fields: [actorId], references: [id], onDelete: Restrict)
  supersedes   StopProgressEvent? @relation("StopProgressVoid", fields: [orderId, stopId, step, supersedesEventId], references: [orderId, stopId, step, id], onDelete: Restrict)
  supersededBy StopProgressEvent? @relation("StopProgressVoid")
  state        StopProgressState?

  @@unique([stopId, clientRequestId])
  @@unique([orderId, stopId, step, id], map: "stop_progress_event_order_stop_step_id_key")
  @@unique([orderId, stopId, step, supersedesEventId], map: "stop_progress_event_void_target_key")
  @@index([orderId, stopId, step])
}

model StopProgressState {
  orderId       String           @db.Uuid
  stopId        String           @db.Uuid
  step          StopProgressStep
  activeEventId String           @unique @db.Uuid
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  stop        OrderStop         @relation(fields: [stopId, orderId], references: [id, orderId], onDelete: Restrict)
  activeEvent StopProgressEvent @relation(fields: [orderId, stopId, step, activeEventId], references: [orderId, stopId, step, id], onDelete: Restrict)

  @@id([orderId, stopId, step])
  @@unique([orderId, stopId, step, activeEventId], map: "stop_progress_state_active_event_key")
}

model OutboxEvent {
  id              String            @id @default(uuid()) @db.Uuid
  aggregateType   String            @db.VarChar(64)
  aggregateId     String            @db.Uuid
  type            OutboxEventType
  schemaVersion   Int               @default(1)
  inputRevision   Int?
  payload         Json
  dedupeKey       String            @unique
  status          OutboxEventStatus @default(PENDING)
  attempts        Int               @default(0)
  maxAttempts     Int               @default(8)
  leaseOwner      String?           @db.VarChar(128)
  leaseGeneration Int               @default(0)
  leaseExpiresAt  DateTime?         @db.Timestamptz(3)
  nextAttemptAt   DateTime          @default(now()) @db.Timestamptz(3)
  lastError       String?           @db.VarChar(500)
  completedAt     DateTime?         @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([aggregateId, type, inputRevision(sort: Desc)])
}
