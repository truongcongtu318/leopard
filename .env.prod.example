# LEOPARD Demo Deployment — Environment Variables
# Copy to .env.prod and adjust as needed. deploy-demo.sh auto-generates secrets.

NODE_ENV=production
PORT=3000

# ── Database ──
POSTGRES_DB=leopard
POSTGRES_USER=leopard
POSTGRES_PASSWORD=leopard_demo_change_me
DATABASE_URL=postgresql://leopard:leopard_demo_change_me@postgres:5432/leopard?schema=public

# ── Auth (secrets auto-generated by deploy-demo.sh) ──
AUTH_PROVIDER=demo
AUTH_DEMO_LOGIN_ENABLED=true
AUTH_ACCESS_TOKEN_SECRET=CHANGE_ME_32_BYTES
AUTH_REFRESH_TOKEN_SECRET=CHANGE_ME_32_BYTES
ESTIMATE_TOKEN_HMAC_SECRET=CHANGE_ME_32_BYTES

# ── CORS (gateway port 80 + direct ports) ──
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3002,http://localhost:8081,http://localhost:8082

# ── Providers (demo mode) ──
MAP_PROVIDER=demo
ALLOW_DEMO_PROVIDER=true
SOCKET_PROVIDER=in-memory
ALLOW_IN_MEMORY_SOCKET_PROVIDER=true
STORAGE_PROVIDER=local
ALLOW_LOCAL_STORAGE_PROVIDER=true
PAYMENT_PROVIDER=demo
ALLOW_DEMO_PAYMENT_PROVIDER=true
INVOICE_PROVIDER=self
MAIL_PROVIDER=console
ALLOW_CONSOLE_MAIL_PROVIDER=true

# ── Firebase (demo) ──
FIREBASE_PROJECT_ID=leopard-demo

# ── Pricing ──
PRICING_MINIMUM_FARE_VND=70000
PRICING_STOP_SURCHARGE_VND=30000
PRICING_VEHICLE_RATES_JSON={"MOTORBIKE":{"baseFareVnd":70000,"perKmVnd":10000,"loadingFeeVnd":60000},"VAN":{"baseFareVnd":130000,"perKmVnd":14000,"loadingFeeVnd":100000},"TRUCK":{"baseFareVnd":200000,"perKmVnd":18000,"loadingFeeVnd":150000}}

# ── Ports ──
API_PORT=3000
ADMIN_PORT=3002
GATEWAY_PORT=80

# ── API Docs ──
ENABLE_API_DOCS=true
