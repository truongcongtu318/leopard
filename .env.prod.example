# LEOPARD Demo Deployment — Environment Variables
# Copy to .env.prod, then run: ./infra/scripts/deploy-demo.sh
# The deploy script fills every CHANGE_ME_* placeholder with a random secret.

NODE_ENV=production
PORT=3000

# ── Database ──
POSTGRES_DB=leopard
POSTGRES_USER=leopard
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql://leopard:CHANGE_ME_DB_PASSWORD@postgres:5432/leopard?schema=public

# ── Auth (demo mode: 1-click login with accountId, no real OTP/Firebase) ──
AUTH_PROVIDER=demo
AUTH_DEMO_LOGIN_ENABLED=true
# Demo credentials are meant for local and staging. A production deployment has
# to acknowledge them explicitly — the API refuses to start with
# AUTH_DEMO_LOGIN_ENABLED=true otherwise, mirroring the ALLOW_* flags below.
# Keep this true only for a client demo box.
ALLOW_DEMO_AUTH_PROVIDER=true
AUTH_ACCESS_TOKEN_SECRET=CHANGE_ME_ACCESS_SECRET
AUTH_REFRESH_TOKEN_SECRET=CHANGE_ME_REFRESH_SECRET
ESTIMATE_TOKEN_HMAC_SECRET=CHANGE_ME_ESTIMATE_SECRET

# ── CORS ──
CORS_ORIGINS=http://localhost,http://localhost:3002,http://localhost:8081,http://localhost:8082

# Origin used to build media URLs for locally stored files; the API appends the
# /files/<key> route itself, so this must NOT include /files.
# Keep it root-relative: the value resolves against whatever origin the client
# is already using, so it works over an IP, a domain, or an HTTPS tunnel. An
# absolute http://<ip>:3000 value is blocked as mixed content the moment the
# apps are served over HTTPS, and cargo photos / POD signatures stop loading.
PUBLIC_FILES_BASE_URL=/

# ── Providers (all demo/local: no external accounts required) ──
MAP_PROVIDER=demo
ALLOW_DEMO_PROVIDER=true
SOCKET_PROVIDER=in-memory
ALLOW_IN_MEMORY_SOCKET_PROVIDER=true
STORAGE_PROVIDER=local
ALLOW_LOCAL_STORAGE_PROVIDER=true
PAYMENT_PROVIDER=demo
ALLOW_DEMO_PAYMENT_PROVIDER=true
INVOICE_PROVIDER=self
MAIL_PROVIDER=console
ALLOW_CONSOLE_MAIL_PROVIDER=true

# ── Firebase (demo placeholder, FCM disabled) ──
FIREBASE_PROJECT_ID=leopard-demo
FCM_ENABLED=false

# ── External providers left blank on purpose ──
VIETMAP_API_KEY=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# ── Pricing ──
PRICING_MINIMUM_FARE_VND=70000
PRICING_STOP_SURCHARGE_VND=30000
PRICING_VEHICLE_RATES_JSON={"MOTORBIKE":{"baseFareVnd":70000,"perKmVnd":10000,"loadingFeeVnd":60000},"VAN":{"baseFareVnd":130000,"perKmVnd":14000,"loadingFeeVnd":100000},"TRUCK":{"baseFareVnd":200000,"perKmVnd":18000,"loadingFeeVnd":150000}}

# ── Ports ──
API_PORT=3000
ADMIN_PORT=3002
CUSTOMER_PORT=8081
DRIVER_PORT=8082
GATEWAY_PORT=80

# ── API Docs (Swagger) ──
ENABLE_API_DOCS=true
