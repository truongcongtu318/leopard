{
  "name": "@leopard/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "format:check": "prettier --check package.json tsconfig.json src",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.test.json"
  },
  "devDependencies": {
    "@leopard/config": "workspace:*",
    "vitest": "4.1.10"
  }
}
