{
  "name": "@leopard/validators",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "format:check": "prettier --check package.json tsconfig.json src",
    "lint": "eslint .",
    "prebuild": "pnpm --filter @leopard/shared build",
    "pretest": "pnpm --filter @leopard/shared build",
    "pretypecheck": "pnpm --filter @leopard/shared build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.test.json"
  },
  "dependencies": {
    "@leopard/shared": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@leopard/config": "workspace:*",
    "vitest": "4.1.10"
  }
}
